# Copy to .env.garnocex on Garnocex. Never commit the populated file.
POSTGRES_DB=agenda
POSTGRES_USER=agenda
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
# Optional overrides; blank uses the production defaults for the garnocex proxy.
# ALLOWED_HOSTS defaults to garnocex.unex.es (comma-separated hosts).
ALLOWED_HOSTS=
# CSRF_TRUSTED_ORIGINS defaults to https://garnocex.unex.es (comma-separated origins).
CSRF_TRUSTED_ORIGINS=
# URL prefix the proxy mounts the app under. Blank defaults to /agenda; "/" serves
# the app from the domain root (only for a root-mounted proxy).
DJANGO_SCRIPT_NAME=
# Optional: port exposed only on the server loopback interface.
APP_PORT=8000
DJANGO_DEBUG=False
